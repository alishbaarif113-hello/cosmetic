<div class="container" style="max-width: 800px; margin: 60px auto; padding: 0 20px;">
  <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.5rem; margin-bottom: 12px; text-align: center;">{{ article.title }}</h1>
  <p style="text-align: center; color: #888; font-size: 0.9rem; margin-bottom: 30px;">{{ article.published_at | date: "%B %d, %Y" }}</p>
  {% if article.image %}
    <div style="margin-bottom: 30px; text-align: center;">
      <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title }}" style="max-width: 100%; border-radius: 8px;">
    </div>
  {% endif %}
  <div class="rte" style="line-height: 1.8; color: #444;">
    {{ article.content }}
  </div>
</div>
