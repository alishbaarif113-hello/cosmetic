<div class="container" style="max-width: 1000px; margin: 60px auto; padding: 0 20px;">
  <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.5rem; margin-bottom: 30px; text-align: center;">{{ blog.title }}</h1>
  <div style="display: grid; gap: 30px;">
    {% for article in blog.articles %}
      <article style="border-bottom: 1px solid #eee; padding-bottom: 24px;">
        <h2><a href="{{ article.url }}" style="color: inherit; text-decoration: none;">{{ article.title }}</a></h2>
        <p style="color: #666; font-size: 0.9rem;">{{ article.published_at | date: "%B %d, %Y" }}</p>
        <p style="margin-top: 10px;">{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
        <a href="{{ article.url }}" style="color: var(--color-primary); font-weight: 600; text-decoration: none; margin-top: 8px; display: inline-block;">Read more &rarr;</a>
      </article>
    {% endfor %}
  </div>
</div>
