<div class="container" style="max-width: 1200px; margin: 60px auto; padding: 0 20px;">
  <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.5rem; margin-bottom: 30px; text-align: center;">All Collections</h1>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;">
    {% for collection in collections %}
      <div class="category-card" style="border: 1px solid #f0e6e4; border-radius: 8px; overflow: hidden; text-align: center; padding: 20px;">
        <h3><a href="{{ collection.url }}" style="color: inherit; text-decoration: none;">{{ collection.title }}</a></h3>
        <p style="color: #888; font-size: 0.9rem; margin-top: 8px;">{{ collection.all_products_count }} products</p>
      </div>
    {% endfor %}
  </div>
</div>
