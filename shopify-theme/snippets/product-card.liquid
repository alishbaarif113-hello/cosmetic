<div class="product-card">
  <div class="product-thumb-box" onclick="location.href='{{ product.url }}'">
    {%- if product.compare_at_price > product.price -%}
      <span class="product-tag">SALE</span>
    {%- elsif product.tags contains 'bestseller' -%}
      <span class="product-tag">BESTSELLER</span>
    {%- endif -%}
    <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
    <a href="{{ product.url }}" class="quick-view-btn">View Product</a>
  </div>
  <div class="product-info-box">
    <div class="product-rating">
      <span>★★★★★</span>
      <span class="product-reviews-count">(5.0)</span>
    </div>
    <h3 class="product-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card-price-row">
      <span class="current-price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="compare-price">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" class="btn-add-to-cart">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        Add to Cart
      </button>
    {%- endform -%}
  </div>
</div>
