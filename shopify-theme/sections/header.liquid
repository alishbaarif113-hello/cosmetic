<header class="site-header">
  <div class="container header-inner">
    <a href="{{ routes.root_url }}" class="brand-logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" style="max-width: {{ section.settings.logo_width }}px;">
      {%- else -%}
        <span class="logo-title">{{ section.settings.brand_name | default: 'LUMIÈRE' }}</span>
        <span class="logo-subtitle">{{ section.settings.brand_subtitle | default: 'COSMETICS' }}</span>
      {%- endif -%}
    </a>

    <nav class="main-nav" aria-label="Navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}">{{ link.title | upcase }}</a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="nav-link active">HOME</a>
        <a href="{{ routes.all_products_collection_url }}" class="nav-link">SHOP</a>
        <a href="/collections/skin-care" class="nav-link">SKIN CARE</a>
        <a href="/collections/makeup" class="nav-link">MAKEUP</a>
        <a href="/collections/hair-care" class="nav-link">HAIR CARE</a>
        <a href="/pages/about" class="nav-link">ABOUT US</a>
        <a href="/blogs/news" class="nav-link">BLOG</a>
        <a href="/pages/contact" class="nav-link">CONTACT US</a>
      {%- endfor -%}
    </nav>

    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="action-icon-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="action-icon-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="action-icon-btn js-cart-drawer-trigger" id="cart-icon-bubble" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="badge-count cart-badge">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "LUMIÈRE"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand Tagline",
      "default": "COSMETICS"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 160,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
