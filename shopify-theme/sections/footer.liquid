<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <div class="brand-logo" style="margin-bottom: 16px;">
        <span class="logo-title">{{ section.settings.brand_title | default: 'LUMIÈRE' }}</span>
        <span class="logo-subtitle">{{ section.settings.brand_subtitle | default: 'COSMETICS' }}</span>
      </div>
      <p>{{ section.settings.brand_bio | default: "Empowering your beauty with nature's finest and science's best." }}</p>
      <div class="social-links-row">
        <a class="social-link" href="#" title="Facebook">f</a>
        <a class="social-link" href="#" title="Instagram">ig</a>
        <a class="social-link" href="#" title="Twitter">x</a>
        <a class="social-link" href="#" title="Pinterest">p</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>QUICK LINKS</h4>
      <ul class="footer-links-list">
        {%- for link in section.settings.menu_1.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- else -%}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/blogs/news">Blog</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="footer-col">
      <h4>CUSTOMER CARE</h4>
      <ul class="footer-links-list">
        {%- for link in section.settings.menu_2.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- else -%}
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="/policies/refund-policy">Return Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms & Conditions</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/faq">FAQs</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="footer-col">
      <h4>LET'S CONNECT</h4>
      <ul class="contact-info-list">
        <li class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{{ section.settings.phone | default: '+1 (800) 123-4567' }}</span>
        </li>
        <li class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>{{ section.settings.email | default: 'hello@lumierecosmetics.com' }}</span>
        </li>
        <li class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{{ section.settings.address | default: '123 Beauty Street, Los Angeles, CA 90001' }}</span>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>NEWSLETTER</h4>
      <p>{{ section.settings.newsletter_text | default: 'Subscribe for exclusive offers and beauty tips.' }}</p>
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Enter your email" required class="newsletter-input-box">
        <button type="submit" class="btn-subscribe">SUBSCRIBE</button>
      {%- endform -%}
    </div>
  </div>

  <div class="container footer-bottom-row">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Powered by Shopify.</span>
    <div class="payment-icons">
      <span class="payment-badge">VISA</span>
      <span class="payment-badge">MASTERCARD</span>
      <span class="payment-badge">AMEX</span>
      <span class="payment-badge">PAYPAL</span>
      <span class="payment-badge">APPLE PAY</span>
      <span class="payment-badge">SHOP PAY</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_title", "label": "Brand Title", "default": "LUMIÈRE" },
    { "type": "text", "id": "brand_subtitle", "label": "Brand Subtitle", "default": "COSMETICS" },
    { "type": "textarea", "id": "brand_bio", "label": "Brand Tagline", "default": "Empowering your beauty with nature's finest and science's best." },
    { "type": "link_list", "id": "menu_1", "label": "Quick Links Menu" },
    { "type": "link_list", "id": "menu_2", "label": "Customer Care Menu" },
    { "type": "text", "id": "phone", "label": "Phone Number", "default": "+1 (800) 123-4567" },
    { "type": "text", "id": "email", "label": "Email Address", "default": "hello@lumierecosmetics.com" },
    { "type": "text", "id": "address", "label": "Physical Address", "default": "123 Beauty Street, Los Angeles, CA 90001" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter Text", "default": "Subscribe for exclusive offers and beauty tips." }
  ]
}
{% endschema %}
