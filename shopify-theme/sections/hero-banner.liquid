<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-content">
      <h1 class="hero-title">{{ section.settings.heading | default: 'Reveal Your Natural Beauty' }}</h1>
      <p class="hero-subtitle">{{ section.settings.subheading | default: 'Premium cosmetics crafted with natural ingredients for healthy, glowing skin.' }}</p>
      
      {%- if section.settings.button_label != blank -%}
        <div class="hero-actions">
          <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn-primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}

      <div class="hero-badges-row">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'badge' -%}
              <div class="hero-badge-item" {{ block.shopify_attributes }}>
                <div class="hero-badge-icon">
                  {%- if block.settings.icon == 'leaf' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L8 8a6 6 0 0 0 8 0l-4-6z"/><path d="M12 14v8"/></svg>
                  {%- elsif block.settings.icon == 'heart' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17a5 5 0 1 0 10 0c0-2-1.5-3.5-3-4.5 1-1 2-2 2-3.5a4 4 0 0 0-8 0c0 1.5 1 2.5 2 3.5-1.5 1-3 2.5-3 4.5z"/></svg>
                  {%- else -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v4a6 6 0 0 0-6 6v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a6 6 0 0 0-6-6V2"/></svg>
                  {%- endif -%}
                </div>
                <span class="hero-badge-text">{{ block.settings.title }}</span>
              </div>
          {%- endcase -%}
        {%- else -%}
          <div class="hero-badge-item">
            <div class="hero-badge-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L8 8a6 6 0 0 0 8 0l-4-6z"/><path d="M12 14v8"/></svg></div>
            <span class="hero-badge-text">Natural Ingredients</span>
          </div>
          <div class="hero-badge-item">
            <div class="hero-badge-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17a5 5 0 1 0 10 0c0-2-1.5-3.5-3-4.5 1-1 2-2 2-3.5a4 4 0 0 0-8 0c0 1.5 1 2.5 2 3.5-1.5 1-3 2.5-3 4.5z"/></svg></div>
            <span class="hero-badge-text">Cruelty Free</span>
          </div>
          <div class="hero-badge-item">
            <div class="hero-badge-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v4a6 6 0 0 0-6 6v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a6 6 0 0 0-6-6V2"/></svg></div>
            <span class="hero-badge-text">Paraben Free</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-image-wrapper">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" />
        {%- else -%}
          <img src="{{ 'hero-cosmetics.jpg' | asset_url }}" alt="Lumière Skincare Set" loading="eager" />
        {%- endif -%}
        <div class="hero-floating-card">
          <div class="floating-stars">★★★★★</div>
          <div class="floating-text">
            <strong>4.9 / 5.0 Rating</strong>
            <span>Loved by 25,000+ Customers</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reveal Your Natural Beauty"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium cosmetics crafted with natural ingredients for healthy, glowing skin."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Natural Ingredients"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart / Rabbit" },
            { "value": "flask", "label": "Flask" }
          ],
          "default": "leaf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
