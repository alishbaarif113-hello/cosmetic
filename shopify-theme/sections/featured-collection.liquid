<section class="products-section">
  <div class="container">
    <div class="section-header-flex">
      <div>
        <span class="section-label">{{ section.settings.subheading | default: 'BEST SELLERS' }}</span>
        <h2 class="section-title">{{ section.settings.heading | default: 'Our Most Loved Products' }}</h2>
      </div>
      {%- if section.settings.show_view_all -%}
        <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="link-all-products">
          VIEW ALL PRODUCTS →
        </a>
      {%- endif -%}
    </div>

    <div class="products-grid">
      {%- assign featured_collection = section.settings.collection -%}
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <!-- Static fallback demonstration cards matching reference design -->
        <div class="product-card">
          <div class="product-thumb-box">
            <span class="product-tag">BESTSELLER</span>
            <img src="{{ 'product-serum.jpg' | asset_url }}" alt="Radiance Facial Serum" />
          </div>
          <div class="product-info-box">
            <div class="product-rating"><span>★★★★★</span><span class="product-reviews-count">(128)</span></div>
            <h3 class="product-card-title">Radiance Facial Serum</h3>
            <div class="product-card-price-row"><span class="current-price">$34.99</span></div>
            <button class="btn-add-to-cart">Add to Cart</button>
          </div>
        </div>

        <div class="product-card">
          <div class="product-thumb-box">
            <span class="product-tag">SPF 15</span>
            <img src="{{ 'product-cream.jpg' | asset_url }}" alt="Hydrating Day Cream" />
          </div>
          <div class="product-info-box">
            <div class="product-rating"><span>★★★★★</span><span class="product-reviews-count">(94)</span></div>
            <h3 class="product-card-title">Hydrating Day Cream</h3>
            <div class="product-card-price-row"><span class="current-price">$29.99</span></div>
            <button class="btn-add-to-cart">Add to Cart</button>
          </div>
        </div>

        <div class="product-card">
          <div class="product-thumb-box">
            <span class="product-tag">ORGANIC</span>
            <img src="{{ 'product-cleanser.jpg' | asset_url }}" alt="Gentle Face Wash" />
          </div>
          <div class="product-info-box">
            <div class="product-rating"><span>★★★★★</span><span class="product-reviews-count">(215)</span></div>
            <h3 class="product-card-title">Gentle Face Wash</h3>
            <div class="product-card-price-row"><span class="current-price">$19.99</span></div>
            <button class="btn-add-to-cart">Add to Cart</button>
          </div>
        </div>

        <div class="product-card">
          <div class="product-thumb-box">
            <span class="product-tag">ROSE INFUSED</span>
            <img src="{{ 'product-toner.jpg' | asset_url }}" alt="Hydrating Toner" />
          </div>
          <div class="product-info-box">
            <div class="product-rating"><span>★★★★★</span><span class="product-reviews-count">(86)</span></div>
            <h3 class="product-card-title">Hydrating Toner</h3>
            <div class="product-card-price-row"><span class="current-price">$22.99</span></div>
            <button class="btn-add-to-cart">Add to Cart</button>
          </div>
        </div>

        <div class="product-card">
          <div class="product-thumb-box">
            <span class="product-tag">NEW</span>
            <img src="{{ 'product-serum.jpg' | asset_url }}" alt="Rose Bloom Perfume" />
          </div>
          <div class="product-info-box">
            <div class="product-rating"><span>★★★★★</span><span class="product-reviews-count">(64)</span></div>
            <h3 class="product-card-title">Rose Bloom Perfume</h3>
            <div class="product-card-price-row"><span class="current-price">$49.99</span></div>
            <button class="btn-add-to-cart">Add to Cart</button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "BEST SELLERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Most Loved Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 5, "label": "Number of products" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
